VITE_ROOM_SERVER=wss://<your-railway-domain>

# Voice chat relay (TURN). Client, set on Vercel. Without it, players on mobile data often cannot hear each other.
# VITE_TURN_URL=turn:<host>:3478,turns:<host>:5349
# VITE_TURN_USER=...
# VITE_TURN_CREDENTIAL=...

# Accounts (Clerk). Client, set on Vercel; with no key the game runs with no sign-in.
# VITE_CLERK_PUBLISHABLE_KEY=pk_...

# Cloud saves. Server only, set on Railway (never in the client).
# DATABASE_URL=postgres://...      (link a Railway Postgres database)
# CLERK_SECRET_KEY=sk_...
# ALLOWED_ORIGIN=https://<your-vercel-domain>

# Gem purchases (Paystack). Server only, set on Render, never in the client. Use the sk_test_ key until live payments are approved.
# No sign-in needed to buy. Webhook URL to set in the Paystack dashboard: https://<your-room-server>/pay/webhook
# PAYSTACK_SECRET_KEY=sk_test_...

VITE_ADSENSE_CLIENT=ca-pub-5927752342380516
# Set to 1 (production builds only) to serve real, paying ads. Leave unset to get test ads.
# VITE_ADS_LIVE=1

# Error monitoring (Sentry). DSNs are built in (client: production builds; server: on Render). These only override them.
# Client, set on Vercel (the DSN is public by design):
# VITE_SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# Server, set on Render (use a separate Sentry project for it):
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
