VITE_ROOM_SERVER=wss://<your-railway-domain>

# Accounts (Clerk). Client, set on Vercel; with no key the game runs with no sign-in.
# VITE_CLERK_PUBLISHABLE_KEY=pk_...

# Cloud saves. Server only, set on Railway (never in the client).
# DATABASE_URL=postgres://...      (link a Railway Postgres database)
# CLERK_SECRET_KEY=sk_...
# ALLOWED_ORIGIN=https://<your-vercel-domain>

VITE_ADSENSE_CLIENT=ca-pub-5927752342380516
